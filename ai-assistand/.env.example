# Copy to .env and fill in secrets.
# docker compose up --build -d reads this file for the API container.

DeepSeek__ApiKey=
DeepSeek__BaseUrl=https://api.deepseek.com
DeepSeek__Model=deepseek-chat
FishAudio__ApiKey=
FishAudio__BaseUrl=https://api.fish.audio
FishAudio__VoiceId=

# Only needed for local (non-Docker) API runs.
# Compose overrides this to Host=postgres automatically.
ConnectionStrings__Postgres=Host=localhost;Port=5433;Database=personal_assistant;Username=postgres;Password=123456
